<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator android:propertyName="cardElevation"
            android:valueTo="8" android:valueType="floatType" android:duration="120"/>
    </item>
    <item>
        <objectAnimator android:propertyName="cardElevation"
            android:valueTo="4" android:valueType="floatType" android:duration="120"/>
    </item>
</selector>
