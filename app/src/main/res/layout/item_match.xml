<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_rounded"
    android:clipToOutline="true">

    <!-- 🔹 Arka plan resmi -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        android:contentDescription="@string/match_background" />

    <!-- 🔹 Üstüne hafif karartma (okunabilirlik için) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- 🔹 İçerik -->
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical">

        <!-- Oyun adı -->
        <TextView
            android:id="@+id/game"
            android:text="LOL"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Takım isimleri -->
        <TextView
            android:id="@+id/title"
            android:text="T1 vs GenG"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Alt bilgi -->
        <TextView
            android:id="@+id/subtitle"
            android:text="upcoming • 18:00"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Durum etiketi -->
        <com.google.android.material.chip.Chip
            android:id="@+id/status"
            style="@style/Widget.Material3.Chip.Assist.Elevated"
            android:text="upcoming • 18:00"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/teal_700"
            app:chipStrokeWidth="0dp"
            app:chipCornerRadius="8dp" />

        <!-- (isteğe bağlı) Saat ve skor -->
        <TextView
            android:id="@+id/time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/score"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
