<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottomsheet_round">

    <TextView
        android:id="@+id/txtTitle"
        android:text="@string/filter_by_game"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_all"
            style="@style/Widget.Material3.Chip.Filter"
            android:text="@string/filter_all"
            android:checked="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_selector"
            android:textColor="@color/chip_text_selector"
            app:checkedIconVisible="false"
            app:rippleColor="@color/chip_bg_selector"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_lol"
            style="@style/Widget.Material3.Chip.Filter"
            android:text="@string/game_lol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_selector"
            android:textColor="@color/chip_text_selector"
            app:checkedIconVisible="false"
            app:rippleColor="@color/chip_bg_selector"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_valorant"
            style="@style/Widget.Material3.Chip.Filter"
            android:text="@string/game_valorant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_selector"
            android:textColor="@color/chip_text_selector"
            app:checkedIconVisible="false"
            app:rippleColor="@color/chip_bg_selector"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_cs2"
            style="@style/Widget.Material3.Chip.Filter"
            android:text="@string/game_cs2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/chip_bg_selector"
            android:textColor="@color/chip_text_selector"
            app:checkedIconVisible="false"
            app:rippleColor="@color/chip_bg_selector"/>
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApply"
        android:layout_marginTop="16dp"
        android:text="@string/action_apply"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:cornerRadius="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>

